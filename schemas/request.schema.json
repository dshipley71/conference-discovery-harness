{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conference-discovery-harness.example.invalid/schemas/request.schema.json",
  "title": "Conference Discovery Harness Request",
  "description": "Logical data contract for the values recorded in REQUEST.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "mode",
    "run_id",
    "source_run_id",
    "recorded_at",
    "objective",
    "date_range",
    "geography",
    "topics_or_keywords",
    "search_languages",
    "output_language",
    "known_public_sources",
    "source_rules",
    "result_limit",
    "attendee_mode",
    "attendee_authorization",
    "user_constraints",
    "clarification_history"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact": {
      "const": "REQUEST.md"
    },
    "mode": {
      "enum": [
        "full",
        "discovery_only",
        "refresh"
      ]
    },
    "run_id": {
      "$ref": "#/$defs/runId"
    },
    "source_run_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/runId"
        },
        {
          "type": "null"
        }
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "date_range": {
      "$ref": "#/$defs/dateRange"
    },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "places",
        "include_online"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "places": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "include_online": {
          "type": "boolean"
        }
      }
    },
    "topics_or_keywords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "search_languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/language"
      }
    },
    "output_language": {
      "$ref": "#/$defs/language"
    },
    "known_public_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knownSource"
      }
    },
    "source_rules": {
      "$ref": "#/$defs/sourceRules"
    },
    "result_limit": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "const": "no-limit"
        }
      ]
    },
    "attendee_mode": {
      "$ref": "#/$defs/attendeeMode"
    },
    "attendee_authorization": {
      "$ref": "#/$defs/requestAuthorization"
    },
    "user_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "clarification_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/clarification"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "refresh"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "source_run_id": {
            "$ref": "#/$defs/runId"
          }
        }
      },
      "else": {
        "properties": {
          "source_run_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "attendee_mode": {
            "const": "public-only"
          }
        },
        "required": [
          "attendee_mode"
        ]
      },
      "then": {
        "properties": {
          "attendee_authorization": {
            "properties": {
              "basis": {
                "const": "intentionally-public"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "attendee_mode": {
            "const": "user-authorized-input"
          }
        },
        "required": [
          "attendee_mode"
        ]
      },
      "then": {
        "properties": {
          "attendee_authorization": {
            "properties": {
              "basis": {
                "const": "user-authorized-input"
              },
              "authorized_inputs": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "attendee_mode": {
            "const": "disabled"
          }
        },
        "required": [
          "attendee_mode"
        ]
      },
      "then": {
        "properties": {
          "attendee_authorization": {
            "properties": {
              "basis": {
                "const": "disabled"
              },
              "authorized_inputs": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 120
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "attendeeMode": {
      "enum": [
        "public-only",
        "user-authorized-input",
        "disabled"
      ]
    },
    "dateRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "start_open_ended",
        "end_open_ended"
      ],
      "properties": {
        "start": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_open_ended": {
          "type": "boolean"
        },
        "end_open_ended": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "start": {
                "type": "null"
              }
            },
            "required": [
              "start"
            ]
          },
          "then": {
            "properties": {
              "start_open_ended": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "start_open_ended": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "end": {
                "type": "null"
              }
            },
            "required": [
              "end"
            ]
          },
          "then": {
            "properties": {
              "end_open_ended": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "end_open_ended": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "knownSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_class",
        "name",
        "public_url",
        "note"
      ],
      "properties": {
        "source_class": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "public_url": {
          "type": "string",
          "format": "uri"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sourceRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructions",
        "required_source_classes",
        "excluded_source_classes",
        "required_domains_or_publishers",
        "excluded_domains_or_publishers",
        "access_constraints"
      ],
      "properties": {
        "instructions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_source_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_source_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_domains_or_publishers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_domains_or_publishers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "access_constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requestAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "description",
        "authorized_inputs",
        "personal_data_minimization"
      ],
      "properties": {
        "basis": {
          "enum": [
            "intentionally-public",
            "user-authorized-input",
            "disabled"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "authorized_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "personal_data_minimization": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorded_at",
        "ambiguity",
        "question",
        "answer",
        "scope_effect"
      ],
      "properties": {
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "ambiguity": {
          "enum": [
            "conference-identity",
            "date-range",
            "geography",
            "attendee-authorization",
            "other-material-boundary",
            "none"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "scope_effect": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
